#!/bin/sh
# AiraLang Native Launch Script
DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [ -x "$DIR/s1duo/bin/airalang" ]; then
    exec "$DIR/s1duo/bin/airalang" "$@"
elif [ -x "/data/data/com.termux/files/usr/bin/airalang" ]; then
    exec "/data/data/com.termux/files/usr/bin/airalang" "$@"
fi
exec python3 "$DIR/src/cli.py" "$@"
